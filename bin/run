#!/usr/bin/env ruby
# frozen_string_literal: true

unless ENV['FIREJAIL_SANDBOX']
  if system('which firejail > /dev/null 2>&1')
    exec 'firejail', '--net-keep', "--whitelist=#{Dir.pwd}", '--env=FIREJAIL_SANDBOX=1', $0, *ARGV
  end
end

require 'bundler/setup'
Bundler.require(:default) # Loads all gems in Gemfile automatically

require 'net/http'
require 'json'
require 'uri'

require_relative '../lib/utils/config'
require_relative '../lib/client'
require_relative '../lib/tool'
require_relative '../lib/tool_executor'
require_relative '../lib/context_manager'
require_relative '../lib/setup'
require_relative '../lib/memory'
require_relative '../lib/session_manager'
require_relative '../lib/tagger'

LIB_PATH = File.expand_path('../lib/', __dir__)
tools_pattern = File.join(LIB_PATH, 'tools', '*.rb')
Dir.glob(tools_pattern).sort.each { |file| require file }

if ARGV.include?('--setup')
  Setup.run
else
  begin
    memory = Memory.new
    client = Client.new
    tagger = Tagger.new(client, memory)
    config = Config.new
    tool_executor = ToolExecutor.new

    session_index = ARGV.index('--session')
    session_id = if session_index
                   next_arg = ARGV[session_index + 1]
                   next_arg&.match(/^\d+$/) ? next_arg.to_i : SessionManager.sessions_menu(memory)
                 end
    session_id ||= memory.create_session
    context = ContextManager.new(client, system_prompt: config.system_prompt, memory: memory, session_id: session_id,
                                         tagger: tagger)

    SessionManager.load_messages(memory, context, session_id) if session_index
    loop do
      print "\nYou: "
      input = $stdin.gets&.chomp
      break if input.nil? || input.strip.empty?

      context.add_user_message({ role: 'user', content: input })

      loop do
        message = client.raw_chat(context.messages, tools: Tool.schemas)
        context.add(message)

        if message['tool_calls']&.any?
          tool_executor.call(message['tool_calls']).each { |msg| context.add(msg) }
        else
          puts "\nAssistant: #{message['content']} "
          break
        end
      rescue StandardError => e
        puts "\nError: #{e.message}. Please try again."
        context.messages.pop
        break
      end
    end
  rescue RuntimeError => e
    puts "Error: #{e.message}"
  end
end
