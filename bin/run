#!/usr/bin/env ruby
# frozen_string_literal: true

unless ENV['FIREJAIL_SANDBOX']
  if system('which firejail > /dev/null 2>&1')
    exec 'firejail', '--net-keep', "--whitelist=#{Dir.pwd}", '--env=FIREJAIL_SANDBOX=1', $0, *ARGV
  end
end

require 'bundler/setup'
Bundler.require(:default) # Loads all gems in Gemfile automatically

require 'net/http'
require 'json'
require 'uri'

require_relative '../lib/utils/config'
require_relative '../lib/client'
require_relative '../lib/tool'
require_relative '../lib/tool_executor'
require_relative '../lib/context_manager'

LIB_PATH = File.expand_path('../lib/', __dir__)
tools_pattern = File.join(LIB_PATH, 'tools', '*.rb')
Dir.glob(tools_pattern).sort.each { |file| require file }

client = Client.new
config = Config.new
tool_executor = ToolExecutor.new
context = ContextManager.new(client, system_prompt: config.system_prompt)

loop do
  print "\nYou: "
  input = gets&.chomp
  break if input.nil? || input.strip.empty?

  context.add_user_message({ role: 'user', content: input })

  loop do
    message = client.raw_chat(context.messages, tools: Tool.schemas)
    context.add(message)

    if message['tool_calls']
      tool_executor.call(message['tool_calls']).each { |msg| context.add(msg) }
    else
      puts "\nAssistant: #{message['content']} "
      break
    end
  rescue StandardError => e
    puts "\nError: #{e.message}. Please try again."
    context.messages.pop
    break
  end
end
